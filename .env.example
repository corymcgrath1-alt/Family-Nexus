# Local development placeholders only. Do not commit real secrets.

# Administrative connection used only for reviewed migrations and controlled
# setup. The API must never receive this URL.
DATABASE_MIGRATION_URL=postgres://lighthouse_dev_admin:replace-with-admin-password@127.0.0.1:5432/lighthouse_dev

# Restricted application runtime connection. This role must inherit only from
# the `lighthouse_runtime` database role created by the migrations.
DATABASE_URL=postgres://lighthouse_dev_app:replace-with-runtime-password@127.0.0.1:5432/lighthouse_dev

# Disposable integration/E2E database managed by `pnpm run db:test:*`.
TEST_DATABASE_MIGRATION_URL=postgres://lighthouse_test:lighthouse_test_password@127.0.0.1:55432/lighthouse_test
TEST_DATABASE_URL=postgres://lighthouse_test_app:lighthouse_test_app_password@127.0.0.1:55432/lighthouse_test
TEST_CONNECTOR_WORKER_DATABASE_URL=postgres://lighthouse_test_worker:lighthouse_test_worker_password@127.0.0.1:55432/lighthouse_test

# Dedicated scheduled-worker login. It inherits restricted runtime RLS and the
# connector claim/maintenance capability only; never use a migration owner.
CONNECTOR_WORKER_DATABASE_URL=postgres://lighthouse_dev_worker:replace-with-worker-password@127.0.0.1:5432/lighthouse_dev

# Connector runtime. Fake mode is accepted only outside production.
CONNECTOR_PROVIDER_MODE=fake
CONNECTOR_APP_ORIGIN=http://127.0.0.1:5173
CONNECTOR_ALLOWED_REDIRECT_PATHS=/connectors
CONNECTOR_ACTIVE_KEY_VERSION=local-v1
# JSON object mapping key version to one base64-encoded 32-byte AES key.
CONNECTOR_CREDENTIAL_KEYS_JSON={"local-v1":"replace-with-base64-encoded-32-byte-key"}
CONNECTOR_BACKFILL_PAST_DAYS=365
CONNECTOR_BACKFILL_FUTURE_DAYS=365

# Optional live Google OAuth configuration. Never commit real values.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/connectors/google-calendar/oauth/callback

# Express session signing secret for local development.
SESSION_SECRET=replace-with-a-local-random-secret

# App/API local ports.
PORT=5000
FAMILY_APP_PORT=5173
BASE_PATH=/

# Optional Vite dev proxy target used by E2E/local two-server development.
API_PROXY_TARGET=http://127.0.0.1:5000
